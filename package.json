{
  "name": "lowdiff",
  "private": true,
  "version": "0.0.1",
  "description": "AI review annotations layered over GitHub pull-request diffs",
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b",
    "build": "npm run build --workspace @lowdiff/extension"
  },
  "devDependencies": {
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
