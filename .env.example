# Copy to .env and fill in the provider you want to use.
# Only needed for the CLI (apps/cli). The extension stores keys in the browser,
# not here.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional. Fine-grained token, read-only on Contents, Pull requests, Metadata.
# Without one, public repos work at 60 API requests/hour instead of 5,000.
GITHUB_TOKEN=
